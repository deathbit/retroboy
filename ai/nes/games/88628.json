  "synopsis": [
    {
      "langue": "en",
      "text": "Also known as The Story of Three Kingdoms. RPG with tactical combat and rather detailed cutscenes."
    },
    {
      "langue": "fr",
      "text": "Également connu sous le nom de L'Histoire des Trois Royaumes. RPG avec des combats tactiques et des cinématiques plutôt détaillées."
    },
    {
      "langue": "de",
      "text": "Auch bekannt als Die Geschichte der drei Königreiche. RPG mit taktischem Kampf und ziemlich detaillierten Zwischensequenzen."
    },
    {
      "langue": "es",
      "text": "También conocido como The Story of Three Kingdoms. Es un RPG con combate táctico y escenas bastante detalladas."
    },
    {
      "langue": "it",
      "text": "Conosciuto anche come La storia dei tre regni. RPG con combattimento tattico e filmati piuttosto dettagliati."
    },
    {
      "langue": "pt",
      "text": "Também conhecida como A História dos Três Reinos. RPG com combate tático e cenas bastante detalhadas."
    }
  ],
