  "synopsis": [
    {
      "langue": "en",
      "text": "Classic game &quot;Balda&quot;, you need to make words from letters. Requires a good understanding of the Russian language."
    },
    {
      "langue": "fr",
      "text": "Jeu classique de « Balda » : il faut former des mots à partir de lettres. Une bonne compréhension du russe est requise."
    },
    {
      "langue": "de",
      "text": "Klassisches Spiel „Balda“, Sie müssen Wörter aus Buchstaben bilden. Erfordert ein gutes Verständnis der russischen Sprache."
    },
    {
      "langue": "es",
      "text": "Balda es un clásico juego de palabras en el que debes formar nuevas palabras a partir de las letras disponibles. Requiere un buen dominio del idioma ruso."
    }
