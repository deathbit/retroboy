  "synopsis": [
    {
      "langue": "en",
      "text": "Orebody: Sand Ripples is a short, box-pushing puzzle game for the NES. It takes place in the sci-fi fantasy world of Orebody, a planet known for its mining operations. In Sand Ripples, players control a sand squid in the Great Sand Sea Solorus, Orebody's largest desert. The Mining Cartel has threatened the delicate ecosystem of Solorus, and it's up to the sand squid to fill in their mining tunnels and foil their operations."
    }
  ],
