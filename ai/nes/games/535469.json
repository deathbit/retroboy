  "synopsis": [
    {
      "langue": "en",
      "text": "BlobQuest is a homebrew platform and puzzle game developed for the classic NES console. The story follows a protagonist who has been transformed into a blob by an evil wizard, forcing them to explore various worlds to collect 8 mystical rubies and restore their true human form."
    },
    {
      "langue": "es",
      "text": "BlobQuest es un juego homebrew de plataformas y puzles desarrollado para la clásica consola NES. La historia sigue a un protagonista que ha sido convertido en una masa (blob) por un malvado mago, obligándolo a explorar mundos para recolectar 8 rubíes místicos y recuperar su verdadera forma humana."
    }
  ],
