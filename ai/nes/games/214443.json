  "synopsis": [
    {
      "langue": "en",
      "text": "Super Bat Puncher is an original homebrew game for the NES console. Explore the dark caverns of a mysterious planet and find out about the plague that threatens Earth."
    },
    {
      "langue": "fr",
      "text": "Super Bat Puncher est une jeu hombrew pour la console NES. Explorez les sombres cavernes d'une mystérieuse planète et découvrez la peste qui menace cette endroit."
    },
    {
      "langue": "de",
      "text": "Super Bat Puncher ist ein originales Homebrew-Spiel für die NES-Konsole. Erkunden Sie die dunklen Höhlen eines mysteriösen Planeten und erfahren Sie mehr über die Seuche, die die Erde bedroht."
    },
    {
      "langue": "es",
      "text": "Super Bat Puncher es un juego casero original para la consola NES. Explora las cavernas oscuras de un planeta misterioso y investiga sobre la plaga que amenaza la Tierra."
    },
    {
      "langue": "it",
      "text": "Super Bat Puncher è un gioco homebrew originale per la console NES. Esplora le oscure caverne di un pianeta misterioso e scopri la piaga che minaccia la Terra."
    },
    {
      "langue": "pt",
      "text": "Super Bat Puncher é um jogo homebrew original para o console NES. Explore as cavernas escuras de um planeta misterioso e descubra sobre a praga que ameaça a Terra."
    }
  ],
