  "synopsis": [
    {
      "langue": "en",
      "text": "Kagerou Densetsu is an RPG adventure with side-scrolling battles where players take control of 4 ninja on a journey to defeat the leader of four daevas threatening the world."
    },
    {
      "langue": "fr",
      "text": "Kagerou Densetsu est une aventure RPG avec des batailles à défilement horizontal où les joueurs prennent le contrôle de 4 ninja pour vaincre le leader des quatre daevas qui menacent le monde."
    },
    {
      "langue": "de",
      "text": "Kagerou Densetsu ist ein Rollenspiel-Abenteuer mit Side-Scrolling-Schlachten, in dem die Spieler die Kontrolle über 4 Ninjas auf einer Reise übernehmen, um den Anführer von vier Daevas zu besiegen, die die Welt bedrohen."
    },
    {
      "langue": "es",
      "text": "Kagerou Densetsu es una aventura de rol con batallas de desplazamiento lateral en la que los jugadores toman el control de 4 ninjas en un viaje para derrotar al líder de cuatro daevas que amenazan al mundo."
    },
    {
      "langue": "it",
      "text": "Kagerou Densetsu è un'avventura RPG con battaglie a scorrimento laterale in cui i giocatori prendono il controllo di 4 ninja in un viaggio per sconfiggere il leader di quattro daeva che minacciano il mondo."
    },
    {
      "langue": "pt",
      "text": "Kagerou Densetsu é uma aventura de RPG com batalhas de rolagem lateral onde os jogadores assumem o controle de 4 ninjas em uma jornada para derrotar o líder de quatro daevas que ameaçam o mundo."
    }
  ],
