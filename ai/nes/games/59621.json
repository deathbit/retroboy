  "synopsis": [
    {
      "langue": "en",
      "text": "Flipull: An Exciting Cube Game is a Puzzle game, developed by Daiei Seisakusho and published by Taito Corporation, which was released in Japan in 1989."
    },
    {
      "langue": "fr",
      "text": "Flipull: An Exciting Cube Game est un jeu de réflexion développé par Daiei Seisakusho et publié par Taito Corporation, sorti au Japon en 1989."
    },
    {
      "langue": "de",
      "text": "Flipull: An Exciting Cube Game ist ein Puzzlespiel, das von Daiei Seisakusho entwickelt und von der Taito Corporation veröffentlicht wurde und 1989 in Japan veröffentlicht wurde."
    },
    {
      "langue": "es",
      "text": "Flipull: An Exciting Cube Game es un juego de rompecabezas, desarrollado por Daiei Seisakusho y publicado por Taito Corporation, que se lanzó en Japón en 1989."
    },
    {
      "langue": "it",
      "text": "Flipull: An Exciting Cube Game è un gioco Puzzle, sviluppato da Daiei Seisakusho e pubblicato da Taito Corporation, che è stato rilasciato in Giappone nel 1989."
    }
