  "synopsis": [
    {
      "langue": "en",
      "text": "Mizushima Shinji no Daikoushien is a baseball simulation game based on Shinji Mizushima's manga Daikoushien. It features characters from the manga in bright colors."
    },
    {
      "langue": "fr",
      "text": "Mizushima Shinji no Daikoushien est un jeu de simulation de baseball basé sur le manga Daikoushien de Shinji Mizushima. Le jeu met en scène des personnages du manga dans des couleurs vives. La partie jeu de baseball est tout à fait classique par rapport aux autres jeux du genre."
    },
    {
      "langue": "de",
      "text": "Mizushima Shinji no Daikoushien ist ein Baseball-Simulationsspiel, das auf Shinji Mizushimas Manga Daikoushien basiert. Es zeigt Figuren aus dem Manga in leuchtenden Farben."
    },
    {
      "langue": "es",
      "text": "Mizushima Shinji no Daikoushien es un juego de simulación de béisbol basado en el manga Daikoushien de Shinji Mizushima. Presenta a los personajes del manga con colores brillantes."
    }
  ],
