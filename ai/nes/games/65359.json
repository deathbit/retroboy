  "synopsis": [
    {
      "langue": "en",
      "text": "Battle Baseball is a Sports game, developed by Minato Giken and published by Banpresto, which was released in Japan in 1993."
    },
    {
      "langue": "fr",
      "text": "Battle Baseball est un jeu de sport complétement décalé dans lequel vous pouvez incarner Godzilla en tant que batteur. Ce jeu exclusivement traduit en Japonais peut se jouer à deux."
    },
    {
      "langue": "de",
      "text": "Battle Baseball ist ein ganz besonderes Sportspiel, bei dem man als Schlagzeuger Godzilla spielen kann. Dieses Spiel, das ausschließlich ins Japanische übersetzt wurde, kann paarweise gespielt werden."
    },
    {
      "langue": "es",
      "text": "Battle Baseball es un juego de deportes, desarrollado por Minato Giken y publicado por Banpresto, que se lanzó en Japón en 1993."
    },
    {
      "langue": "it",
      "text": "Battle Baseball è un gioco sportivo del tutto particolare in cui puoi giocare nei panni di Godzilla come batterista. Questo gioco, tradotto esclusivamente in giapponese, può essere giocato in coppia."
    },
    {
      "langue": "pt",
      "text": "Battle Baseball é um jogo de esportes completamente peculiar no qual você pode jogar como Godzilla como o baterista. Este jogo, que é traduzido exclusivamente para o japonês, pode ser jogado em pares."
    }
  ],
