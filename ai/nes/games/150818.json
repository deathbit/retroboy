  "synopsis": [
    {
      "langue": "en",
      "text": "A Nintendo Entertainment System version of Fantasy World Dizzy titled Mystery World Dizzy was developed in April 1993 but was not released until 24 years later in April 2017. It's available free on the official Dizzy website."
    },
    {
      "langue": "fr",
      "text": "Une version Nintendo Entertainment System de Fantasy World Dizzy intitulée Mystery World Dizzy a été développée en avril 1993 mais n'est sortie que 24 ans plus tard, en avril 2017. Elle est disponible gratuitement sur le site officiel de Dizzy."
    },
    {
      "langue": "de",
      "text": "Eine NES-Version von Fantasy World Dizzy mit dem Titel Mystery World Dizzy wurde im April 1993 entwickelt, aber erst 24 Jahre später, im April 2017, veröffentlicht. Sie ist kostenlos auf der offiziellen Dizzy-Website erhältlich."
    },
    {
      "langue": "es",
      "text": "Una versión de Fantasy World Dizzy de Nintendo Entertainment System, titulada Mystery World Dizzy, se desarrolló en abril de 1993, pero no se lanzó hasta 24 años después en abril de 2017. Está disponible de forma gratuita en el sitio web oficial de Dizzy."
    },
    {
      "langue": "it",
      "text": "Una versione per Nintendo Entertainment System di Fantasy World Dizzy intitolata Mystery World Dizzy è stata sviluppata nell'aprile 1993 ma è stata rilasciata solo 24 anni dopo, nell'aprile 2017. È disponibile gratuitamente sul sito Web ufficiale di Dizzy."
    },
    {
      "langue": "pt",
      "text": "Uma versão do Fantasy World Dizzy do Nintendo Entertainment System intitulada Mystery World Dizzy foi desenvolvida em abril de 1993, mas não foi lançada até 24 anos depois, em abril de 2017. Está disponível gratuitamente no site oficial Dizzy."
    }
  ],
