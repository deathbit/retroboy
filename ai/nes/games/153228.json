  "synopsis": [
    {
      "langue": "en",
      "text": "Pokémon Gold is a port of the Game Boy Color game of the same name to the Famicom/NES. The game mainly follows the plot of Pokémon Gold, but the gameplay mechanics are somewhat different and the game itself is in Chinese."
    },
    {
      "langue": "fr",
      "text": "Pokémon Or est un portage Famicom/NES du jeu Game Boy Color du même nom. Le jeu suit globalement le scénario de Pokémon Or, mais ses mécaniques de gameplay diffèrent quelque peu, et le jeu est en chinois."
    },
    {
      "langue": "de",
      "text": "Pokémon Gold ist eine Portierung des gleichnamigen Spiels für Game Boy Color auf Famicom/NES. Das Spiel folgt im Wesentlichen der Handlung von Pokémon Gold, aber die Spielmechanik ist etwas anders und das Spiel selbst ist auf Chinesisch."
    },
    {
      "langue": "es",
      "text": "Pokémon Oro es una adaptación del juego homónimo de Game Boy Color para Famicom/NES. El juego sigue principalmente la trama de Pokémon Oro, pero la mecánica de juego es algo diferente y está en chino."
    }
  ],
