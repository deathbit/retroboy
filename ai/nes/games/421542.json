  "synopsis": [
    {
      "langue": "en",
      "text": "Ready to go on an adventure with your favorite Arina and Daniella? This is a Game Gyaru fan game, completely compatible with original NES hardware! Explore an abandoned space station in this open world adventure and if you have a friend you can explore it together in 2 player co-op!"
    },
    {
      "langue": "de",
      "text": "Bist du bereit für ein Abenteuer mit deinen Lieblingsfiguren Arina und Daniella? Dies ist ein Game Gyaru-Fanspiel, das vollständig mit der originalen NES-Hardware kompatibel ist! Erkunde eine verlassene Raumstation in diesem Open-World-Abenteuer und wenn du einen Freund hast, kannst du sie gemeinsam im 2-Spieler-Koop-Modus erkunden!"
    }
  ],
