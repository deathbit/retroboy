  "synopsis": [
    {
      "langue": "en",
      "text": "The Maniac summons Mr. McDanielson once more to his Deth Complex! This time the Maniac has taken McDanielson's wife, &quot;Kira&quot;, hostage and is going to turn her into one of his zombie slaves. McDanielson must traverse the dangerous complex once more to save his wife and kill the Maniac once and for all!"
    },
    {
      "langue": "de",
      "text": "Der Verrückte ruft Mr. McDanielson erneut in seinen Todeskomplex! Diesmal hat der Verrückte McDanielsons Frau „Kira“ als Geisel genommen und will sie in eine seiner Zombiesklavinnen verwandeln. McDanielson muss den gefährlichen Komplex erneut durchqueren, um seine Frau zu retten und den Verrückten ein für alle Mal zu töten!"
    }
  ],
