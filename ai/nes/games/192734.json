  "synopsis": [
    {
      "langue": "en",
      "text": "Harvest Moon is a pirated game of NES released in 2003-04, based off a farm simulation role-playing of a port of SNES game of the same name."
    },
    {
      "langue": "de",
      "text": "Harvest Moon ist ein Raubkopienspiel von NES, das 2003-04 veröffentlicht wurde und auf einem Farm-Simulations-Rollenspiel eines gleichnamigen SNES-Spiels basiert."
    },
    {
      "langue": "es",
      "text": "Harvest Moon es un juego pirata de NES lanzado en 2003-04, basado en un juego de rol de simulación de granja, es un port del juego SNES del mismo nombre."
    },
    {
      "langue": "it",
      "text": "Harvest Moon è un gioco piratato per NES pubblicato nel 2003-04, basato su un gioco di ruolo di simulazione di una fattoria di un port del gioco SNES con lo stesso nome."
    }
  ],
