  "synopsis": [
    {
      "langue": "en",
      "text": "Lin Ze Xu Jin Yan is an action role playing game for the Nintendo Entertainment System.\r\n\r\nThis is the fully translated English version of of the Chinese game Lin Zexu - No Smoking for the NES."
    },
    {
      "langue": "fr",
      "text": "Lin Ze Xu Jin Yan est un jeu de rôle d'action pour le Nintendo Entertainment System.\r\n\r\nCeci est la version anglaise entièrement traduite du jeu chinois Lin Zexu - No Smoking for the NES."
    },
    {
      "langue": "de",
      "text": "Lin Ze Xu Jin Yan ist ein Action-Rollenspiel für das Nintendo Entertainment System. Dies ist die vollständig übersetzte englische Version des chinesischen Spiels Lin Zexu - No Smoking für das NES."
    },
    {
      "langue": "es",
      "text": "Lin Ze Xu Jin Yan es un juego de acción para la Nintendo Entertainment System. Esta es la versión en inglés completamente traducida del juego chino Lin Zexu - No Smoking para la NES."
    },
    {
      "langue": "it",
      "text": "Lin Ze Xu Jin Yan è un gioco di ruolo d'azione per Nintendo Entertainment System.\r\nnnQuesta è la versione inglese completamente tradotta del gioco cinese Lin Zexu - No Smoking per NES."
    },
    {
      "langue": "pt",
      "text": "Esta é a versão inglesa totalmente traduzida do jogo chinês Lin Zexu - No Smoking para o NES."
    }
  ],
