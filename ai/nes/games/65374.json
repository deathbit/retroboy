  "tips": [
    {
      "langue": "en",
      "titre": "Stage/Level Skip",
      "description": "On both Player 1 and Player 2's controllers, hold A and B, then press Reset. This will allow you later to press B in the game map to change your stage. Likewise, pressing Up/Down will let you change your level when in a level. Press A to play the desired level."
    }
