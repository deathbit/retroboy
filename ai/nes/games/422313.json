  "synopsis": [
    {
      "langue": "en",
      "text": "With Rainbow Brite: Journey to Rainbow Land, enter a fun magical adventure dedicated to create a colourful world. Help Rainbow Brite and her pal Starlite in this classic RPG. Explore mazes and labyrinths, and face Murky and Lurky the two evil ones trying to grey up the land. Defeat dozens of enemies by crawling, bouncing, and rolling"
    }
