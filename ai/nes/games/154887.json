  "synopsis": [
    {
      "langue": "en",
      "text": "A fan-made &quot;sequel&quot; to Castlevania I created by Dr. Mario. A hack of the European version of the original NES Castlevania game. Features a Castlevania Chronicles like sprite for Simon"
    },
    {
      "langue": "fr",
      "text": "Une &quot;fan-suite&quot; de Castlevania I créée par Dr. Mario. Un hack de la version européenne du jeu original NES Castlevania. Le sprite de Simon est tiré de Chronicles Castlevania."
    },
    {
      "langue": "de",
      "text": "Eine von Fans gemachte &quot;Fortsetzung&quot; von Castlevania, die ich von Dr. Mario. Ein Hack der europäischen Version des ursprünglichen NES Castlevania-Spiels. Verfügt über eine Castlevania Chronicles wie Sprite für Simon"
    },
    {
      "langue": "es",
      "text": "&quot;Secuela&quot; hecha por fanáticos de Castlevania y creada por el Dr. Mario. Hack de la versión europea del juego original de NES Castlevania. Cuenta con los sprites de Castlevania Chronicles para Simon."
    },
    {
      "langue": "it",
      "text": "Un &quot;sequel&quot; fan-made di Castlevania creato dal Dr. Mario. Un hack della versione europea del gioco originale per NES Castlevania. Contiene un Castlevania Chronicles come uno sprite per Simon."
    },
    {
      "langue": "pt",
      "text": "Uma &quot;sequência de fãs&quot; de Castlevania I criada pelo Dr. Mario. Um hack da versão europeia do jogo NES Castlevania original. O sprite de Simão é retirado de Chronicles Castlevania."
    }
  ],
