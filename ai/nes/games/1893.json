  "tips": [
    {
      "langue": "fr",
      "titre": "Choix du niveau",
      "description": "Choisissez le mode aventure puis pendant le jeu, prenez la seconde manette et appuyez sur START, A, SELECT, B. Appuyez ensuite sur Droite pour le MALL, sur Gauche pour la PLAGE, ou sur Haut pour la PLANETE.\n"
    },
    {
      "langue": "fr",
      "titre": "Planches illimitées",
      "description": "Faites revenir votre personnage quand il attend en haut de la rampe. Appuyez sur START, START et SELECT quand vous le verrez se gratter la tête. Vous entendrez une sirène qui confirmera que le code a bien été entré. Vous puvez maintenant rider pendant trois minutes.\n"
    },
    {
      "langue": "fr",
      "titre": "Essais illimités sur le Half-Pipe",
      "description": "Quand le jeu commence, maintenez Haut puis allez tout en heut du Half-Pipe avant de vous laisser tomber en bas. Appuyez ensuite rapidement et plusieurs fois sur START et SELECT jusqu'à entendre un son de cloche.\n"
    }
  ],
