  "synopsis": [
    {
      "langue": "en",
      "text": "Xiao Ma Li is a gambling game for the Nintendo Entertainment System. The game was also re-released by by a different publisher as Small Mary and Bingo."
    },
    {
      "langue": "fr",
      "text": "Xiao Ma Li est un jeu de hasard pour la Nintendo Entertainment System. Le jeu a également été réédité par un éditeur différent sous le nom de Small Mary and Bingo."
    },
    {
      "langue": "de",
      "text": "Xiao Ma Li ist ein Glücksspiel für das Nintendo Entertainment System. Das Spiel wurde auch von einem anderen Verleger als Small Mary und Bingo neu veröffentlicht."
    },
    {
      "langue": "es",
      "text": "Xiao Ma Li es un juego de apuestas para Nintendo Entertainment System. El juego también fue relanzado por una editorial diferente como Small Mary and Bingo."
    },
    {
      "langue": "it",
      "text": "Xiao Ma Li è un gioco d'azzardo per Nintendo Entertainment System. Il gioco è stato anche ripubblicato da un editore diverso come Small Mary e Bingo."
    },
    {
      "langue": "pt",
      "text": "Xiao Ma Li é um jogo de azar para o Nintendo Entertainment System. O jogo também foi relançado por uma editora diferente como Small Mary and Bingo."
    }
