  "synopsis": [
    {
      "langue": "en",
      "text": "Evil Dead is a rom hack of Zelda 2 - The Adventure of Link. It replaces the game's plot, map and sprites to loosely follow the movies."
    },
    {
      "langue": "fr",
      "text": "Evil Dead est un hack rom de Zelda II: The Adventure of Link. Il remplace le scénario, la carte et les sprites du jeu pour suivre librement l'intrigue des films."
    },
    {
      "langue": "de",
      "text": "Evil Dead ist eine Modifikation (rom hack) von Zelda 2 - The Adventure of Link. Ersetzen Sie die Handlung des Spiels, die Karte und die Sprites, um den Filmen vage zu folgen."
    },
    {
      "langue": "es",
      "text": "Evil Dead es una modificación (rom hack) de Zelda 2 - The Adventure of Link. Reemplaza la trama del juego, el mapa y los sprites para seguir vagamente las películas."
    },
    {
      "langue": "it",
      "text": "Evil Dead è un hack rom di Zelda 2 - L'avventura di Link. Sostituisce la trama, la mappa e gli sprite del gioco per seguire liberamente i film."
    },
    {
      "langue": "pt",
      "text": "Evil Dead é um hack romântico de Zelda 2 - The Adventure of Link. Ele substitui o enredo, o mapa e os sprites do jogo para seguir vagamente os filmes."
    }
  ],
