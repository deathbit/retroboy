  "synopsis": [
    {
      "langue": "en",
      "text": "A special (and especially short) demo introducing you to the self-proclaimed greatest treasure hunter and brattiest six-year-old in the multiverse...ALLISON OF ASTRA!"
    },
    {
      "langue": "de",
      "text": "Eine spezielle (und besonders kurze) Demo, die Ihnen den selbsternannten größten Schatzsucher und den mübsten Sechsjährigen im Multiversum vorstellt... ALLISON OF ASTRA!"
    },
    {
      "langue": "es",
      "text": "Una demo especial (y especialmente corta) que te presenta a la autoproclamada mejor cazatesoros y a la niña de seis años más traviesa de todo el multiverso... ¡ALLISON OF ASTRA!"
    },
    {
      "langue": "it",
      "text": "Una demo speciale (e particolarmente breve) che ti introduce alla presunta migliore cacciatrice di tesori e alla più viziata seiennne del multiverso... ALLISON OF ASTRA!"
    }
  ],
