  "synopsis": [
    {
      "langue": "en",
      "text": "In Tracy's NEScapades, you're Tracy &quot;Mimi&quot; Plumlee, a nana who must journey through five of her favorite Nintendo Entertainment System games to rescue her grandkids from the clutches of the dastardly 8-Bits."
    },
    {
      "langue": "de",
      "text": "In Tracy's NEScapades bist du Tracy &quot;Mimi&quot; Plumlee, eine Nana, die durch fünf ihrer Lieblingsspiele von Nintendo Entertainment System reisen muss, um ihre Enkelkinder aus den Fängen der heimtückischen 8-Bits zu retten."
    }
  ],
