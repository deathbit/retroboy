  "synopsis": [
    {
      "langue": "en",
      "text": "AV Pachinko also known as AV Super Real Pachinko is an adult Pachinko simulation game developed by C&E and published by Hacker International in 1991."
    },
    {
      "langue": "fr",
      "text": "AV Pachinko, également connu sous le nom de AV Super Real Pachinko, est un jeu de simulation pour adultes conçu par C & E et publié par Hacker International en 1991."
    },
    {
      "langue": "de",
      "text": "AV Pachinko, auch bekannt als AV Super Real Pachinko, ist ein Pachinko-Simulationsspiel für Erwachsene, das von C&E entwickelt und 1991 von Hacker International veröffentlicht wurde."
    },
    {
      "langue": "es",
      "text": "AV Pachinko también conocido como AV Super Real Pachinko es un juego de simulación de Pachinko para adultos desarrollado por C&E y publicado por Hacker International en 1991."
    },
