  "synopsis": [
    {
      "langue": "en",
      "text": "Famicom Igo Nyuumon is a Miscellaneous game, developed by Home Data and published by I'Max,  which was released in Japan in 1991."
    },
    {
      "langue": "fr",
      "text": "Famicom Igo Nyūmon est un jeu de plateau reprenant les règles du go sur Famicom. Votre objectif consiste à faire des parties de Go contre un adversaire contrôlez par l'ordinateur ou un second joueur. Faites en sorte de déplacer vos pions de tels sortes à former le plus de &quot;territoires&quot; possible, tout en faisant en sorte qu'ils ne ce fassent pas prisonnier par le joueur adverse."
    },
    {
      "langue": "de",
      "text": "Famicom Igo Nyuumon ist ein Verschiedenes Spiel, das von Home Data entwickelt und von I'Max veröffentlicht wurde und 1991 in Japan veröffentlicht wurde."
    },
    {
      "langue": "es",
      "text": "Famicom Igo Nyuumon es un juego Misceláneo, desarrollado por Home Data y publicado por I'Max, que se lanzó en Japón en 1991."
    },
    {
      "langue": "it",
      "text": "Famicom Igo Nyuumon è un gioco Varie, sviluppato da Home Data e pubblicato da I'Max, che è stato rilasciato in Giappone nel 1991."
    }
  ],
