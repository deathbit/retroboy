  "synopsis": [
    {
      "langue": "en",
      "text": "A single-stage &quot;magical girl&quot;-themed shooter released as a demo in 2023. Shoot enemies and avoid bullets. In addition to your main shot, which gets wider as you collect power-tokens, you also have a reserve of three &quot;magic bombs&quot; which immediately turn any bullets on screen into harmless stars which reward points. These bombs do not replenish with lost lives, so use them wisely!"
    }
  ],
