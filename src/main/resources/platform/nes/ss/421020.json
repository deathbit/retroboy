  "synopsis": [
    {
      "langue": "en",
      "text": "Ankoro Mochi Manufacturing Factory is a quick, Othello-like puzzle game where you're competing against the clock to flip over (or eat?) as many Ankoro Mochi as possible."
    },
    {
      "langue": "de",
      "text": "Ankoro Mochi Manufacturing Factory ist ein schnelles, Othello-ähnliches Puzzlespiel, bei dem du gegen die Uhr antrittst, um so viele Ankoro Mochi wie möglich umzudrehen (oder zu essen?)."
    },
    {
      "langue": "es",
      "text": "Ankoro Mochi Manufacturing Factory es un juego de rompecabezas rápido, al estilo Othello, en el que compites contra el reloj para dar vuelta (¿o comer?) tantos Ankoro Mochi como puedas."
    }
  ],
