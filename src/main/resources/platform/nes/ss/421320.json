  "synopsis": [
    {
      "langue": "en",
      "text": "In Crypto-Fascist you play as a government agent pushing pills and stacking bitcoin in a classic &quot;block pushing puzzle&quot; game."
    },
    {
      "langue": "de",
      "text": "In CRYPTO-FASCIST schlüpfst du in die Rolle eines Regierungsagenten, der in einem klassischen Block-Schiebepuzzle-Spiel Pillen verschiebt und Bitcoin anhäuft."
    },
    {
      "langue": "es",
      "text": "En Crypto-Fascist juegas como un agente del gobierno que distribuye pastillas y acumula bitcoin en un clásico juego de rompecabezas de empujar bloques."
    }
  ],
