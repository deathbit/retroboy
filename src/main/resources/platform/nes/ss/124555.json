  "synopsis": [
    {
      "langue": "en",
      "text": "The Super Shinobi is a port of Shinobi III: Return of the Ninja Master from Megadrive/Genesis system, (rather than The Revenge of Shinobi which was sold in Japan under this game's title.) made for the Famicom by Super Game."
    },
    {
      "langue": "fr",
      "text": "Le Super Shinobi est un portage de Shinobi III : Return of the Ninja Master du système Megadrive/Genesis, (plutôt que The Revenge of Shinobi qui a été vendu au Japon sous le titre de ce jeu.) réalisé pour la Famicom par Super Game."
    },
    {
      "langue": "de",
      "text": "Der Super Shinobi ist eine Portierung von Shinobi III: Return of the Ninja Master aus dem Megadrive/Genesis-System (anstatt The Revenge of Shinobi, die in Japan unter dem Titel dieses Spiels verkauft wurde.) für die Famicom von Super Game."
    },
    {
      "langue": "es",
      "text": "El Super Shinobi es un port de Shinobi III: Return of the Ninja Master del sistema Megadrive / Genesis, (en lugar del juego The Revenge of Shinobi que se vendió en Japón bajo el título de este juego) creado para el Famicom por Super Game."
    },
    {
      "langue": "it",
      "text": "Il Super Shinobi è una conversione di Shinobi III: Return of the Ninja Master dal sistema Megadrive/Genesis, (piuttosto che The Revenge of Shinobi che è stato venduto in Giappone con il titolo di questo gioco.) realizzato per Famicom da Super Game."
    },
    {
      "langue": "pt",
      "text": "O Super Shinobi é uma versão do Shinobi III: Retorno do Mestre Ninja do sistema Megadrive / Genesis (em vez de The Revenge of Shinobi, que foi vendido no Japão com o título deste jogo.) Feito para o Famicom pela Super Game."
    }
  ],
