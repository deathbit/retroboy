  "synopsis": [
    {
      "langue": "en",
      "text": "Metal Force is a Korean game with Rockman/Mega Man style, but the character doesn't use enemy's weapons, only his own."
    },
    {
      "langue": "fr",
      "text": "Metal Force est un jeu coréen dans le style Rockman / Mega Man, mais le personnage n'utilise pas les armes de l'ennemi, mais les siennes."
    },
    {
      "langue": "de",
      "text": "Metal Force ist ein koreanisches Spiel im Rockman/Mega Man-Stil, aber der Charakter verwendet nicht die Waffen des Feindes, sondern nur seine eigenen."
    },
    {
      "langue": "es",
      "text": "Metal Force es un juego coreano con estilo Rockman / Mega Man, pero el personaje no usa las armas del enemigo, solo las suyas."
    },
    {
      "langue": "it",
      "text": "Metal Force è un gioco coreano in stile Rockman/Mega Man, ma il personaggio non usa le armi del nemico, solo le sue."
    },
