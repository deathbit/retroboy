  "synopsis": [
    {
      "langue": "en",
      "text": "You Ling Xing Dong (localized as &quot;Hero's Legend&quot;, or &quot;Heroes Legend&quot; according to some cartridge labels) is a Chinese bootleg RPG developed by Henggedianzi. It was also released by Fuzhou Waixing under the name Ying Lie Qun Xia Zhuan."
    },
    {
      "langue": "fr",
      "text": "You Ling Xing Dong (localisé sous le nom Hero's Legend, ou Heroes Legend selon certaines étiquettes de cartouches) est un RPG chinois non officiel développé par Henggedianzi. Il a également été publié par Fuzhou Waixing sous le nom de Ying Lie Qun Xia Zhuan."
    },
    {
      "langue": "de",
      "text": "Dieses Spiel ist das gleiche wie &quot;Ying Lie Qun Xia Zhuan&quot;, außer dass diesmal der chinesische Text durch &quot;Moschn&quot; ersetzt wird, die in Abwesenheit einer Übertragung durch das Fernsehen kriechen."
    },
    {
      "langue": "es",
      "text": "Este juego es el mismo que &quot;Ying Lie Qun Xia Zhuan&quot;, excepto que esta vez el texto chino se reemplaza por &quot;moscas&quot; que se arrastran por la televisión en ausencia de transmisión."
    },
    {
      "langue": "pt",
      "text": "Este jogo é o mesmo que &quot;Ying Lie Qun Xia Zhuan&quot;, mas desta vez o texto chinês é substituído por &quot;moscas&quot; que rastejam na televisão na ausência de transmissão."
    }
  ],
