  "synopsis": [
    {
      "langue": "en",
      "text": "Learn through 5 mini games: A musical piano, Catch numbers, Draw and color shapes, Catch Korean characters and Solve 6 piece mini puzzles."
    },
    {
      "langue": "fr",
      "text": "Apprenez au travers de 5 mini jeux : Un piano musical, Attraper les chiffres, Dessiner et colorier des formes, Attraper des caractères coréens et Résoudre des mini-puzzles de 6 pièces."
    },
    {
      "langue": "de",
      "text": "Lernen Sie durch 5 Minispiele: Ein Musikpiano, Zahlen fangen, Formen zeichnen und färben, koreanische Charaktere fangen und 6-teilige Mini-Rätsel lösen."
    },
    {
      "langue": "es",
      "text": "Juego no licenciado de NES, en el que debemos realizar pruebas de habilidad manejando a un personaje."
    },
    {
      "langue": "it",
      "text": "Impara attraverso 5 mini giochi: Un pianoforte musicale, Cattura numeri, Disegna e colora forme, Cattura personaggi coreani e Risolvi mini puzzle da 6 pezzi."
    },
    {
      "langue": "pt",
      "text": "Aprenda através de 5 minijogos: um piano musical, pegue números, desenhe e pinte formas, pegue personagens coreanos e resolva mini-quebra-cabeças de 6 peças."
    }
  ],
