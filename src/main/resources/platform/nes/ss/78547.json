  "synopsis": [
    {
      "langue": "en",
      "text": "Jogging Race  is a Jogging and Hiking game released only in Japan, on May 28, 1987. It is the fourth game in Bandai's Family Trainer series."
    },
    {
      "langue": "fr",
      "text": "Jogging Race est un jeu de jogging et de randonnée sorti seulement au Japon, le 28 mai 1987. Il s'agit du quatrième jeu de la série Family Trainer de Bandai."
    },
    {
      "langue": "de",
      "text": "Jogging Race ist ein Jogging- und Wanderspiel, das nur in Japan am 28. Mai 1987 veröffentlicht wurde. Es ist das vierte Spiel der Serie Bandai's Family Trainer."
    },
    {
      "langue": "es",
      "text": "Jogging Race es un juego de jogging y senderismo que se lanzó solo en Japón, el 28 de mayo de 1987. Es el cuarto juego de la serie Bandai's Family Trainer."
    },
    {
      "langue": "it",
      "text": "Jogging Race è un gioco di jogging ed escursionismo pubblicato solo in Giappone, il 28 maggio 1987. È il quarto gioco della serie Family Trainer di Bandai."
    },
    {
      "langue": "pt",
      "text": "Jogging Race é um jogo de corrida e caminhada lançado apenas no Japão em 28 de maio de 1987. É o quarto jogo da série Bandai's Family Trainer."
    }
  ],
