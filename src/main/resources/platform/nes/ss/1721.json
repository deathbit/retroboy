  "tips": [
    {
      "langue": "fr",
      "titre": "Choix du niveau",
      "description": "Faites Reset sur votre console 13 fois et appuyez sur Select. Allez sur l'option &quot;Continue&quot; et utilisez les boutons Droite ou Gauche pour choisir un niveau. Appuyez sur Start pour commencer au niveau choisi.\n"
    },
    {
      "langue": "fr",
      "titre": "Test son",
      "description": "Maintenez A + B et allumez votre console. Si ce code ne marche pas, éssayez de maintenir Start + Select + A + B à l'écran de game over. Relâchez tous les boutons quand l'écran devient noir.\n"
    },
    {
      "langue": "fr",
      "titre": "Continuer sa partie",
      "description": "Après avoir perdu sa partie après le niveau 11 ou 12, allez sur &quot;Continue&quot; à l'écran titre et faites sur la deuxième manette Bas et Haut puis appuyez sur Start avec la première manette.\n"
    },
    {
      "langue": "fr",
      "titre": "Gagner des vies",
      "description": "Maintenez A + B et appuyez sur Start à l'écran titre. Apreés avoir ramassé 6 Bonus, tous ceux que vous ramasserez en plus vous donneront une vie suplémentaire.\n"
    },
    {
      "langue": "fr",
      "titre": "Transformer son vaisseau",
      "description": "Quand le jeu démare, maintenez A + B + Select + Start.\n"
    },
    {
      "langue": "fr",
      "titre": "Message caché",
      "description": "Attendez que la fée s'arrète pendant la séquence de fin et appuyez sur A + B sur les deux manettes.\n"
    }
  ],
