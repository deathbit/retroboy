  "synopsis": [
    {
      "langue": "en",
      "text": "Also known as Heroes Legend. Mr Fu Zan of Yanshan Software worked on this game."
    },
    {
      "langue": "fr",
      "text": "Encore un jeu d'aventure/RPG chinois signé Waixing, mais contrairement aux autres, les personnages y sont représentés en pied — comme des gens normaux plutôt que sous forme de silhouettes trapues et tassées."
    },
    {
      "langue": "de",
      "text": "Yet another Chinese RPG/adventure game from Waixing, but unlike the others, the characters here are drawn full-length—like normal people rather than short, squat figures."
    }
