  "synopsis": [
    {
      "langue": "en",
      "text": "A top-down shooter where the player uses a helicopter to fight off enemy forces. It was originally released in Australia under the name Sidewinder."
    },
    {
      "langue": "fr",
      "text": "Un shooter à vue de haut où le joueur utilise un hélicoptère pour combattre les forces ennemies. Il a été initialement publié en Australie sous le nom de Sidewinder."
    },
    {
      "langue": "de",
      "text": "Ein Top-Down-Shooter, bei dem der Spieler einen Hubschrauber benutzt, um feindliche Streitkräfte abzuwehren. Es wurde ursprünglich in Australien unter dem Namen Sidewinder veröffentlicht."
    },
    {
      "langue": "es",
      "text": "Un shooter en modo vertical donde el jugador usa un helicóptero para luchar contra las fuerzas enemigas. Fue originalmente lanzado en Australia bajo el nombre Sidewinder"
    },
    {
      "langue": "it",
      "text": "Uno sparatutto dall'alto in cui il giocatore usa un elicottero per combattere le forze nemiche. È stato originariamente pubblicato in Australia con il nome di Sidewinder."
    },
    {
      "langue": "pt",
      "text": "Um jogo de tiro de cima onde o jogador usa um helicóptero para lutar contra as forças inimigas. Foi originalmente lançado na Austrália como Sidewinder."
    }
  ],
