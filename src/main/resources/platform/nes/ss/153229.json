  "synopsis": [
    {
      "langue": "en",
      "text": "A hack of Kero Kero Keroppi no Daibouken 2 that replaced Keroppi with a green Clefairy, and changed his musical attacks to generic bullets. The title screen reads &quot;GREEN&quot; and the copyright screens and story were once again removed."
    },
    {
      "langue": "de",
      "text": "Ein Hack von Kero Kero Keroppi no Daibouken 2, bei dem Keroppi durch ein grünes Clefairy ersetzt wurde und seine musikalischen Angriffe durch generische Kugeln ersetzt wurden. Auf dem Titelbildschirm steht &quot;GRÜN&quot; und die Copyright-Bildschirme und die Geschichte wurden wieder entfernt."
    }
  ],
