  "synopsis": [
    {
      "langue": "en",
      "text": "The Lion King Legeng is a pirate port of The Lion King game for SNES and Sega Genesis, released by Fuzhou Waixing Computer Science & Technology Co.,LTD in February 1997. The sprites and most of graphics was used from Super Lion King developed by Super Game."
    },
    {
      "langue": "de",
      "text": "The Lion King Legend ist eine Piraten-Portierung von The Lion King-Spiel für SNES und Sega Genesis, das im Februar 1997 von Fuzhou Waixing Computer Science & Technology Co.,LTD veröffentlicht wurde. Die Sprites und die meisten Grafiken wurden von Super Lion King verwendet, der von Super Game entwickelt wurde."
    },
    {
      "langue": "es",
      "text": "El Rey León Legeng es un puerto pirata del juego Rey León para SNES y Sega Genesis, lanzado por Fuzhou Waixing Computer Science & Technology Co., LTD en febrero de 1997. Los Sprites y la mayoría de los gráficos fueron utilizados por Super Lion King Desarrollado por Super juego."
    },
    {
      "langue": "it",
      "text": "The Lion King Legeng è un porting pirata del gioco The Lion King per SNES e Sega Genesis, pubblicato da Fuzhou Waixing Computer Science & Technology Co., LTD nel febbraio 1997. Gli sprite e la maggior parte della grafica sono stati utilizzati da Super Lion King sviluppato da Super Gioco."
    },
    {
      "langue": "pt",
      "text": "O Lion King Legeng é uma versão pirata do jogo The Lion King para SNES e Sega Genesis, lançado pela Fuzhou Waixing Computer Science & Technology Co., LTD em fevereiro de 1997. Os sprites e a maioria dos gráficos foram usados ​​do Super Lion King desenvolvido pela Super Jogo."
    }
  ],
