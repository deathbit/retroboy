  "synopsis": [
    {
      "langue": "en",
      "text": "Grave Digger was developed in about a week. It is a simple puzzle game for the 8-bit Nintendo Entertainment System. If you are familiar with &quot;Lights Out&quot; then you know this game."
    },
    {
      "langue": "de",
      "text": "Grave Digger wurde in etwa einer Woche entwickelt. Es ist ein einfaches Puzzlespiel für das 8-Bit Nintendo Entertainment System. Wenn Sie mit &quot;Lights Out&quot; vertraut sind, dann kennen Sie dieses Spiel."
    }
  ],
