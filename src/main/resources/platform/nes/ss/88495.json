  "synopsis": [
    {
      "langue": "en",
      "text": "The main character, Minky Momo, uses magic to exterminate the wanted Bugoo. As Momo strolls through town, she gets caught up in a case, which she must solve through a variety of sub-games."
    },
    {
      "langue": "fr",
      "text": "Jeu d'aventure basé sur le manga &quot;Princess Minky Momo&quot; (&quot;Il était une fois Gigi&quot; en Francais)"
    },
    {
      "langue": "de",
      "text": "Die Hauptfigur, Minky Momo, nutzt Magie, um den gesuchten Bugoo auszurotten. Während Momo durch die Stadt schlendert, wird sie in einen Fall verwickelt, den sie durch eine Vielzahl von Unterspielen lösen muss."
    },
    {
      "langue": "es",
      "text": "Juego de aventuras basado en el manga &quot;Princess Minky Momo&quot; (&quot;Érase una vez Gigi&quot; en español)"
    },
    {
      "langue": "it",
      "text": "Il personaggio principale, Minky Momo, usa la magia per sterminare il ricercato Bugoo. Mentre Momo passeggia per la città, viene coinvolta in un caso, che deve risolvere attraverso una serie di sottogiochi."
    },
    {
      "langue": "pt",
      "text": "Jogo de aventura baseado no mangá &quot;Princess Minky Momo&quot; (&quot;Era uma vez Gigi&quot; em francês)"
    }
