  "synopsis": [
    {
      "langue": "en",
      "text": "Bring home the excitement of Dragon Boat Festival for the first time ever with this exciting game! Can you beat the foe? Will you become dragon boat master?\r\n"
    },
    {
      "langue": "de",
      "text": "Bringen Sie die Aufregung des Dragon Boat Festivals zum ersten Mal mit diesem aufregenden Spiel nach Hause! Kannst du den Feind schlagen? Wirst du Drachenbootmeister werden?"
    },
    {
      "langue": "es",
      "text": "¡Lleva a casa la emoción del Festival del Bote Dragón por primera vez con este emocionante juego! ¿Podrás vencer al enemigo? ¿Te convertirás en el maestro del Bote Dragón?"
    },
    {
      "langue": "it",
      "text": "Porta a casa l'eccitazione del Dragon Boat Festival per la prima volta in assoluto con questo gioco emozionante! Riesci a battere il nemico? Diventerai il capitano della barca del drago?"
    }
  ],
