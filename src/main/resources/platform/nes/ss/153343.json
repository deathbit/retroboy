  "synopsis": [
    {
      "langue": "en",
      "text": "An aftermarket JRPG released in the Chinese market by Waixing, using the same engine as many other RPGs published by Waixing around that time. It's based on the 2004 release of Dragon Quest 8 for the Sony Playstation 2 and later ported to mobile platforms, but features very different mechanics throughout."
    },
    {
      "langue": "de",
      "text": "Nicht lizenzierte Version des Playstation 2 und Mobile-Spiels, das 2004 in Japan und später im Rest der Welt veröffentlicht wurde. Es ist ein Demade für Nes mit bestimmten Grafiken und Musik eines solchen Systems."
    },
    {
      "langue": "es",
      "text": "Versión sin licenciar del juego de Playstation 2 y móviles que salió en Japón en 2004 y más tarde en el resto del mundo. Es un demade para Nes con gráficos y música particular de dicho sistema."
    }
  ],
