  "tips": [
    {
      "langue": "fr",
      "titre": "Choix du niveau et de la difficulté",
      "description": "Maintenez Haut/Gauche et faites Reset sur votre console. Faites rapiement A + B +Select, A + B + Select avant que l'écran n'apparaisse. Vous pourrez choisir votre niveau et la difficulté.\n"
    },
    {
      "langue": "fr",
      "titre": "Passer un niveau",
      "description": "Mettez le jeu en pause et faites Haut/Gauche, A + B + Select. Votre vaisseau vous mennera directement au niveau suivant.\n"
    },
    {
      "langue": "fr",
      "titre": "Plus de jours",
      "description": "Rentrez un mot de passe valide en changeant le premier chiffre par le nombre jours voulus (entre 0 et 60) et ajoutez-y 40.\n"
    }
