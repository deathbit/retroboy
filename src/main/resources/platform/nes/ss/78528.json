  "synopsis": [
    {
      "langue": "en",
      "text": "It is based nominally on Epoch's Yakyuu Ban series of physical baseball toys, which used pinball mechanics to simulate batting."
    },
    {
      "langue": "fr",
      "text": "C'est le premier jeu publié par Epoch pour un système qu'ils n'ont pas fabriqué eux-mêmes. Il est nominalement basé sur la série de jouets de baseball Yakyuu Ban d'Epoch, qui utilisaient des mécaniques de flipper pour simuler les frappes."
    },
    {
      "langue": "de",
      "text": "Famicom Yakyuuban ist ein Sportspiel, das von SAS Sakata entwickelt und von Epoch veröffentlicht wurde und 1989 in Japan veröffentlicht wurde."
    },
    {
      "langue": "es",
      "text": "Famicom Yakyuuban es un juego de deportes, desarrollado por SAS Sakata y publicado por Epoch, que se lanzó en Japón en 1989."
    },
    {
      "langue": "it",
      "text": "Famicom Yakyuuban è un gioco sportivo, sviluppato da SAS Sakata e pubblicato da Epoch, che è stato rilasciato in Giappone nel 1989."
    },
    {
      "langue": "pt",
      "text": "Famicom Yakyuuban é um jogo de esportes, desenvolvido pela SAS Sakata e publicado pela Epoch, que foi lançado no Japão em 1989."
    }
  ],
