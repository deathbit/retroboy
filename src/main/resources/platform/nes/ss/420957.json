  "synopsis": [
    {
      "langue": "en",
      "text": "The Alfonzo Game is a traditional single-player experience which is a sequel to last year's Kickstarter success Eskimo Bob. This demo contains the first episode of the game, including 15 levels and ending in a boss battle."
    },
    {
      "langue": "fr",
      "text": "Alfonzo Game est un jeu solo classique, suite du succès Kickstarter d'Eskimo Bob. \r\nCette démo contient le premier épisode du jeu, comprenant 15 niveaux et se terminant par un combat de boss."
    },
    {
      "langue": "de",
      "text": "Das Alfonzo-Spiel ist ein traditionelles Einzelspieler-Erlebnis und eine Fortsetzung des letztjährigen Kickstarter-Erfolgs Eskimo Bob. Diese Demo enthält die erste Episode des Spiels, darunter 15 Levels und endet mit einem Bosskampf."
    },
    {
      "langue": "es",
      "text": "The Alfonzo Game es un juego para un jugador, secuela de Eskimo Bob. Esta demo incluye el primer episodio con 15 niveles y termina en una batalla contra un jefe."
    }
  ],
