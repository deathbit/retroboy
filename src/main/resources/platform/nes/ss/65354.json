  "synopsis": [
    {
      "langue": "en",
      "text": "Balloon Monster is an Action game, developed by Mega Soft and published by NTDEC, which was released in Asia in 1991."
    },
    {
      "langue": "fr",
      "text": "Ballon Monster est un clone de Pang et de Buster Bros."
    },
    {
      "langue": "de",
      "text": "Balloon Monster ist ein Actionspiel, das von Mega Soft entwickelt und von NTDEC veröffentlicht wurde und 1991 in Asien veröffentlicht wurde. Das Spiel ist praktisch ein Pang-Klon von Capcom, bei dem der Protagonist auf Blasen schießen muss, die sich gerade getroffen haben."
    },
    {
      "langue": "es",
      "text": "Balloon Monster es un juego de acción, desarrollado por Mega Soft y publicado por NTDEC, que se lanzó en Asia en 1991."
    },
    {
      "langue": "it",
      "text": "Balloon Monster è un gioco d'azione, sviluppato da Mega Soft e pubblicato da NTDEC, che è stato rilasciato in Asia nel 1991.\r\nIl gioco è praticamente un clone di Pang della Capcom, in cui il protagonista deve sparare a delle bolle che si sdoppiano appena colpite."
    },
    {
      "langue": "pt",
      "text": "Balloon Monster é um clone de Pang e Buster Bros."
    }
